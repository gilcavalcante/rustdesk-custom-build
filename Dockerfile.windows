FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# 1. Dependências do Sistema, Compiladores MinGW, LLVM e NSIS
RUN apt-get update && apt-get install -y \
    build-essential \
    autoconf \
    automake \
    libtool \
    m4 \
    gcc-mingw-w64 \
    g++-mingw-w64 \
    gcc-mingw-w64-x86-64 \
    g++-mingw-w64-x86-64 \
    gcc-mingw-w64-i686 \
    g++-mingw-w64-i686 \
    mingw-w64-x86-64-dev \
    mingw-w64-i686-dev \
    mingw-w64-tools \
    clang \
    llvm \
    lld \
    libclang-dev \
    libssl-dev \
    pkg-config \
    nsis \
    cmake \
    ninja-build \
    nasm \
    yasm \
    zip \
    unzip \
    curl \
    git \
    python3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 2. Instalar VCPKG e Compilar Libs para MinGW 64-bits
RUN git clone https://github.com/microsoft/vcpkg.git /vcpkg && \
    /vcpkg/bootstrap-vcpkg.sh -disableMetrics

ENV VCPKG_ROOT=/vcpkg
ENV PATH="${VCPKG_ROOT}:${PATH}"

# Instalar opus, libvpx e libsodium estáticos via vcpkg
RUN vcpkg install opus:x64-mingw-static libvpx:x64-mingw-static libsodium:x64-mingw-static

# 3. Instalar Rustup, Targets MinGW e Cargo Bundle
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

RUN rustup target add x86_64-pc-windows-gnu && \
    rustup target add i686-pc-windows-gnu && \
    cargo install cargo-bundle

WORKDIR /home/user/rustdesk
